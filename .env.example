# Copy to .env for docker compose. Every value is an environment variable read by hpcusage.settings.

# --- database ---------------------------------------------------------------
# Local compose default; point at RDS or any other Postgres for other deployments.
DATABASE_URL=postgresql://hpcusage:hpcusage@db:5432/hpcusage

# --- app ----------------------------------------------------------------------
APP_BASE_URL=http://localhost:8000
SESSION_SECRET=change-me-to-a-long-random-string
LOG_LEVEL=info

# --- auth ---------------------------------------------------------------------
# dev = auto-login as DEV_USER (CAS cannot redirect to localhost). cas = real UC Davis CAS.
AUTH_MODE=dev
DEV_USER=devuser
CAS_BASE=https://cas.ucdavis.edu/cas
CAS_VERSION=3
# Comma-separated usernames allowed in; empty = anyone who can log in with CAS.
ALLOWED_USERS=

# --- collectors ---------------------------------------------------------------
# JSON map of cluster name -> bearer token. Generate tokens with `make token`.
COLLECTOR_TOKENS={"hive": "dev-token-hive", "farm": "dev-token-farm"}
# Optional display metadata per cluster.
CLUSTERS={"hive": {"display_name": "Hive", "timezone": "America/Los_Angeles"}, "farm": {"display_name": "Farm", "timezone": "America/Los_Angeles"}}

# --- retention ----------------------------------------------------------------
JOB_RETENTION_DAYS=400
NODE_SNAPSHOT_RETENTION_DAYS=730

# --- caddy (tls profile only) -------------------------------------------------
HPCUSAGE_HOST=localhost
